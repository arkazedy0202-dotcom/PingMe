<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_ambient"
    android:paddingHorizontal="24dp">

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_status_rose"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:text="LISTENING FOR PINGS"
        android:textColor="@color/pingme_pink_deep"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowView"
        android:layout_width="236dp"
        android:layout_height="236dp"
        android:alpha="0.54"
        android:background="@drawable/bg_aura_glow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/ivHeartPulse"
        app:layout_constraintEnd_toEndOf="@id/ivHeartPulse"
        app:layout_constraintStart_toStartOf="@id/ivHeartPulse"
        app:layout_constraintTop_toTopOf="@id/ivHeartPulse" />

    <ImageView
        android:id="@+id/ivHeartPulse"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_icon_tile"
        android:contentDescription="Menunggu ping"
        android:elevation="10dp"
        android:padding="32dp"
        android:src="@drawable/ic_love"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCallStatus"
        app:tint="@color/pingme_pink" />

    <TextView
        android:id="@+id/tvPingMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Belum ada panggilan.\nPing dari Si Dia akan muncul di sini."
        android:textColor="@color/pingme_cocoa_soft"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHeartPulse" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopAlarm"
        style="@style/Widget.PingMe.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="120dp"
        android:text="Matikan alarm"
        android:visibility="gone"
        app:icon="@drawable/ic_close_rose"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
