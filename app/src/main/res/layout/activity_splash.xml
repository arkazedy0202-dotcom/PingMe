<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_ambient">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoSurface"
        android:layout_width="136dp"
        android:layout_height="136dp"
        app:cardBackgroundColor="#EFFFFFFF"
        app:cardCornerRadius="44dp"
        app:cardElevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42"
        app:strokeColor="#BFFFFFFF"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_pingme" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:alpha="0"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:text="PingMe"
        android:textColor="@color/pingme_charcoal"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoSurface" />

    <TextView
        android:id="@+id/tvSubTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:alpha="0"
        android:letterSpacing="0.045"
        android:text="Dua hati, satu ruang pribadi"
        android:textColor="@color/pingme_cocoa_soft"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTagline" />

    <View
        android:layout_width="42dp"
        android:layout_height="2dp"
        android:layout_marginTop="22dp"
        android:background="@color/pingme_champagne"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubTagline" />
</androidx.constraintlayout.widget.ConstraintLayout>
