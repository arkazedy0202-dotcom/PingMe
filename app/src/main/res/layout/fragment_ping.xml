<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_ambient">

    <LinearLayout
        android:id="@+id/pingHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL SIGNALS"
            android:textAppearance="@style/TextAppearance.PingMe.Eyebrow" />

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kirim ping\nyang terasa personal."
            android:textAppearance="@style/TextAppearance.PingMe.Display"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Pilih alarm tersimpan atau racik pesan baru untuk Si Dia."
            android:textAppearance="@style/TextAppearance.PingMe.Body"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPing"
            style="@style/Widget.PingMe.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Buat ping kustom"
            app:icon="@drawable/ic_add_rose"
            app:iconPadding="8dp"
            app:iconTint="@color/pingme_pink_deep" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pingHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/screen_stagger"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="126dp">

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_surface"
                android:drawableTop="@drawable/ic_love"
                android:drawablePadding="16dp"
                android:elevation="4dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="24dp"
                android:paddingTop="34dp"
                android:paddingEnd="24dp"
                android:paddingBottom="34dp"
                android:text="Belum ada ping kustom\nBuat pesan pertama untuk Si Dia."
                android:textColor="@color/pingme_cocoa_soft"
                android:textSize="14sp"
                android:visibility="visible"
                app:drawableTint="@color/pingme_pink_deep" />

            <LinearLayout
                android:id="@+id/containerPings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:animateLayoutChanges="true"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
