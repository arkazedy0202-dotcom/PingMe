<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_ambient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bgAnimationLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/dashboard_stagger"
            android:paddingBottom="124dp">

            <com.example.pingme.ui.AdaptiveHeaderLayout
                android:id="@+id/headerBrand"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivBrandLogo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_pingme"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/ivBrandLogo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivBrandLogo"
                    app:layout_constraintTop_toTopOf="@id/ivBrandLogo">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="PINGME"
                        android:textColor="@color/pingme_cocoa"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:text="Ruang kecil untuk cerita kalian"
                        android:textColor="@color/pingme_cocoa_soft"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.example.pingme.ui.AdaptiveHeaderLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="0dp"
                android:layout_height="390dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/premium_press"
                app:cardCornerRadius="36dp"
                app:cardElevation="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerBrand"
                app:strokeColor="#80FFFFFF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivCouplePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/pingme_pink_soft"
                        android:contentDescription="@string/couple_photo_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_love" />

                    <com.example.pingme.ui.FloatingLoveFieldView
                        android:id="@+id/heroLoveField"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        app:adaptiveMotionEnabled="true"
                        app:adaptiveQuality="auto" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="235dp"
                        android:background="@drawable/bg_hero_scrim"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvUploadHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_glass_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="GANTI FOTO"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.example.pingme.ui.PremiumOrbView
                        android:id="@+id/premiumOrb"
                        android:layout_width="@dimen/dashboard_orb_size"
                        android:layout_height="@dimen/dashboard_orb_size"
                        android:layout_marginEnd="@dimen/dashboard_orb_margin_end"
                        android:layout_marginTop="@dimen/dashboard_orb_margin_top"
                        app:adaptiveMotionEnabled="true"
                        app:adaptiveQuality="auto"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHeroEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.1"
                        android:text="BERSAMA SEJAK"
                        android:textColor="#DCFFFFFF"
                        android:textSize="11sp"
                        app:layout_constraintBottom_toTopOf="@id/tvDaysConnected"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvDaysConnected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="76sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvDayUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="11dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05"
                        android:text="HARI"
                        android:textColor="@color/pingme_pink_soft"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/tvDaysConnected"
                        app:layout_constraintStart_toEndOf="@id/tvDaysConnected" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:layout_marginBottom="28dp"
                        android:includeFontPadding="false"
                        android:text="Merajut cerita indah bersamamu."
                        android:textColor="#E8FFFFFF"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/rowWidgets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardHero">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBirthday"
                    android:layout_width="0dp"
                    android:layout_height="174dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/premium_press"
                    app:cardBackgroundColor="@color/pingme_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="7dp"
                    app:rippleColor="#22FF8FA3"
                    app:strokeColor="@color/pingme_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.03"
                            android:text="HARI ISTIMEWA"
                            android:textColor="@color/pingme_cocoa_soft"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Kamu"
                            android:textColor="@color/pingme_cocoa_soft"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMyBirthday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Atur ›"
                            android:textColor="@color/pingme_cocoa"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Si Dia"
                            android:textColor="@color/pingme_pink_deep"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvPartnerBirthday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Menunggu"
                            android:textColor="@color/pingme_pink_deep"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuote"
                    android:layout_width="0dp"
                    android:layout_height="174dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/premium_press"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="9dp"
                    app:rippleColor="#35FFFFFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_quote_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:includeFontPadding="false"
                            android:text="“"
                            android:textColor="#DFFFFFFF"
                            android:textSize="35sp" />

                        <TextView
                            android:id="@+id/tvQuote"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:maxLines="4"
                            android:text="&quot;Notifikasi favoritku adalah namamu.&quot;"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="italic" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.82"
                            android:letterSpacing="0.04"
                            android:text="KETUK UNTUK EDIT"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBucketList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/pingme_surface"
                app:cardCornerRadius="30dp"
                app:cardElevation="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowWidgets"
                app:strokeColor="@color/pingme_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="17dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Bucket list"
                                android:textColor="@color/pingme_cocoa"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Rencana kecil, cerita besar"
                                android:textColor="@color/pingme_cocoa_soft"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBucketCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_soft_button"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="7dp"
                            android:text="0/0"
                            android:textColor="@color/pingme_pink_deep"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <com.example.pingme.ui.AdaptiveProgressBar
                        android:id="@+id/pbBucketList"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginBottom="22dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_pingme" />

                    <LinearLayout
                        android:id="@+id/containerBucketList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewWish"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_soft_button"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+  Harapan baru"
                        android:textAllCaps="false"
                        android:textColor="@color/pingme_pink_deep"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="20dp"
                        app:elevation="0dp"
                        app:rippleColor="#30FF8FA3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/pingme_surface"
                app:cardCornerRadius="30dp"
                app:cardElevation="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBucketList"
                app:strokeColor="@color/pingme_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Momen kita"
                        android:textColor="@color/pingme_cocoa"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="20dp"
                        android:text="Simpan yang ingin selalu kalian ingat"
                        android:textColor="@color/pingme_cocoa_soft"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/containerMoments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewMoment"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_soft_button"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+  Tambah momen"
                        android:textAllCaps="false"
                        android:textColor="@color/pingme_pink_deep"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="20dp"
                        app:elevation="0dp"
                        app:rippleColor="#30FF8FA3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
