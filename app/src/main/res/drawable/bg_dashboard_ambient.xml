<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pingme_cream" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="280dp" android:height="280dp" android:top="-90dp" android:right="-80dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="150dp" android:startColor="#42FFB7C5" android:endColor="#00FFF0F5" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="240dp" android:height="240dp" android:bottom="-100dp" android:left="-100dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="130dp" android:startColor="#30FFDEE9" android:endColor="#00FAF5F6" />
        </shape>
    </item>
</layer-list>
