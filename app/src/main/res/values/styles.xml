<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PingMe.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pingme_charcoal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.PingMe.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pingme_charcoal</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.PingMe.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/pingme_cocoa_soft</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.PingMe.Eyebrow" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pingme_pink_deep</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.PingMe.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/pingme_surface_raised</item>
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="hintTextColor">@color/input_hint_color</item>
        <item name="errorTextColor">@color/pingme_error</item>
        <item name="android:textColorHint">@color/pingme_text_muted</item>
    </style>

    <style name="Widget.PingMe.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textColor">@color/button_text_color</item>
        <item name="backgroundTint">@color/button_primary_tint</item>
        <item name="rippleColor">#42FFFFFF</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">6dp</item>
        <item name="android:stateListAnimator">@animator/premium_press</item>
    </style>

    <style name="Widget.PingMe.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pingme_pink_deep</item>
        <item name="backgroundTint">@color/pingme_blush</item>
        <item name="strokeColor">@color/pingme_outline_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#30D76480</item>
        <item name="cornerRadius">18dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@animator/premium_press</item>
    </style>

    <style name="Widget.PingMe.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/pingme_surface_raised</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">5dp</item>
        <item name="strokeColor">@color/pingme_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ThemeOverlay.PingMe.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/pingme_pink_deep</item>
        <item name="colorSurface">@color/pingme_pearl</item>
        <item name="colorOnSurface">@color/pingme_charcoal</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PingMe.Dialog</item>
    </style>

    <style name="ShapeAppearance.PingMe.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.PingMe.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/pingme_blush</item>
        <item name="shapeAppearance">@style/ShapeAppearance.PingMe.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.PingMe.NavIndicator" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">18dp</item>
    </style>
</resources>
